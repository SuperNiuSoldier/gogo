.app .calendar-expand { display:flex; align-items:center; justify-content:center; width:100%; min-height:44px; }
.flipped { transform:rotate(180deg); }
.reminder-divider { margin:6px 22px; color:var(--muted); font-size:calc(14px * var(--text-scale,1)); }
.drawn-rule { height:8px; margin-top:8px; border-bottom:1px solid var(--border); border-radius:50% 40% 55% 45%; opacity:.7; }
.reminders-scroll { flex:1; min-height:0; height:0; }
.reminder-list { padding:0 22px; }
.reminder-row { display:flex; align-items:center; gap:8px; }
.app .reminder-open { display:flex; align-items:center; text-align:left; flex:1; min-width:0; padding:13px 0; gap:16px; }
.app .reminder-open > view { min-width:0; }
.reminder-title { font-size:calc(18px * var(--text-scale,1)); display:block; overflow-wrap:break-word; }
