.reminder-empty { min-height:120px; }
.error-banner { position:absolute; bottom:100px; left:16px; right:16px; padding:10px 14px; background:var(--paper); color:var(--danger); border:1px solid var(--danger); border-radius:12px; font-size:calc(14px * var(--text-scale,1)); z-index:3; }
.sheet-backdrop { position:absolute; inset:0; z-index:10; display:flex; align-items:flex-end; }
.sheet-scrim { position:absolute; inset:0; background:var(--scrim); }
.sheet { position:relative; width:100%; background:var(--paper); border-radius:26px 25px 0 0; padding-bottom:var(--safe-bottom, 0px); display:flex; flex-direction:column; max-height:90%; box-shadow:0 -5px 24px #00000018; animation:sheet-enter .25s cubic-bezier(.2,.8,.2,1); }
.sheet-header { display:flex; align-items:center; justify-content:space-between; gap:4px; padding:14px 12px 12px; flex-shrink:0; }
.sheet-title { font-size:calc(21px * var(--text-scale,1)); }
