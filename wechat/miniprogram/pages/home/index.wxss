.keepsake-halo { position:absolute; width:85%; height:68%; border:1px solid var(--border); opacity:.17; border-radius:48% 52% 45% 55%; transform:rotate(-6deg); }
.keepsake-dog { width:200px; height:200px; max-height:53%; position:relative; }
