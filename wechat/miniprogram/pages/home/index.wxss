.app .day { width:100%; padding:0; height:50px; min-width:0; font-size:calc(19px * var(--text-scale,1)); display:flex; flex-direction:column; align-items:center; justify-content:center; border-radius:48% 52% 46% 54% / 55% 48% 52% 45%; position:relative; }
.app .day.selected { background:var(--soft); }
.app .day.outside { color:var(--muted); }
.day-dot { height:4px; width:4px; border-radius:50%; background:var(--accent); position:absolute; bottom:4px; }
