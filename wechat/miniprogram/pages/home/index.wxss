.keepsake-caption image { width:52px; height:52px; }
.skin-choices { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; margin-bottom:18px; }
.app .skin-choice { position:relative; width:100%; min-height:148px; display:flex; flex-direction:column; align-items:center; justify-content:center; border:1px solid var(--line); border-radius:20px; background:var(--bg); padding:10px; gap:4px; font-size:calc(18px * var(--text-scale,1)); }
.app .skin-choice.chosen { border:2px solid var(--accent); }
.skin-portrait { width:86px; height:86px; }
.skin-check { width:21px; height:21px; position:absolute; top:10px; right:10px; }
.classic-preview { width:86px; height:86px; display:flex; justify-content:center; align-items:center; background:var(--soft); border-radius:48% 52% 46% 54%; }
.classic-preview image { width:34px; height:34px; }
.appearance-row { display:flex; align-items:center; justify-content:space-between; gap:8px; padding:8px 0; border-top:1px solid var(--line); }
.app .brightness-control { display:flex; align-items:center; gap:10px; min-height:48px; padding:0 4px 0 12px; font-size:calc(16px * var(--text-scale,1)); }
