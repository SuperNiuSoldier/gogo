.app .save-button[disabled] { background:var(--accent); color:var(--on-accent); }
.header-spacer { width:50px; }
.sheet-scroll { max-height:65vh; min-height:0; }
.sheet-body { padding:4px 22px 28px; }
.field-error { display:block; padding:10px 0 16px; font-size:calc(15px * var(--text-scale,1)); color:var(--danger); }
.quick-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px 8px; padding:6px 0 18px; }
.app .quick-item { width:100%; padding:0; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:80px; font-size:calc(16px * var(--text-scale,1)); gap:10px; border:1px solid var(--line); border-radius:14px 15px 12px 16px; }
.quick-icon { width:29px; height:29px; }
.avatar-editor { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
.app .avatar-select { display:flex; align-items:center; gap:16px; color:var(--muted); font-size:calc(15px * var(--text-scale,1)); }
.profile-avatar { display:flex; align-items:center; justify-content:center; width:72px; height:72px; border-radius:50%; background:var(--soft); }
.field { margin-bottom:20px; font-size:calc(15px * var(--text-scale,1)); }
.field > label,.field > text { display:block; margin-bottom:8px; color:var(--muted); }
.field input,.field textarea,.picker-value { width:100%; min-height:48px; padding:10px 12px; background:var(--bg); border:1px solid var(--border); border-radius:12px; font-size:calc(18px * var(--text-scale,1)); }
.field textarea { min-height:94px; line-height:1.7; padding-bottom:12px; }
.app .disclosure { justify-content:flex-start; padding:0; margin-bottom:12px; }
.app .danger-button { color:var(--danger); width:100%; border-top:1px solid var(--line); margin-top:24px; padding-top:12px; font-size:calc(15px * var(--text-scale,1)); }
.app .danger { color:var(--danger); }
.owner-label { display:block; color:var(--muted); font-size:calc(14px * var(--text-scale,1)); margin-bottom:14px; }
.kind-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; margin-bottom:22px; }
.app .kind-item { width:100%; padding:0; border:1px solid var(--line); border-radius:14px; font-size:calc(15px * var(--text-scale,1)); }
.app .kind-item.active { background:var(--soft); border-color:var(--accent); }
.weight-input { display:flex; align-items:center; gap:12px; }
.weight-input input { flex:1; min-width:0; }
.date-fields { display:flex; gap:12px; margin-top:20px; }
.date-fields .field { flex:1; min-width:0; }
.picker-value { white-space:nowrap; font-size:calc(16px * var(--text-scale,1)); }
.attachments { display:flex; flex-wrap:wrap; gap:10px; }
.attachment, .app .add-attachment { width:88px; height:88px; position:relative; border-radius:12px; overflow:hidden; background:var(--soft); }
.attachment > image { width:100%; height:100%; }
.attachment > .attachment-placeholder { width:36px; height:36px; margin:26px; }
.app .remove-attachment { position:absolute; top:0; right:0; color:white; background:#171b1aaa; width:44px; height:44px; border-radius:0 0 0 12px; font-size:calc(24px * var(--text-scale,1)); }
.attachment-video { position:absolute; bottom:6px; left:8px; color:white; text-shadow:0 1px 3px #000; }
.app .add-attachment { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px; font-size:calc(12px * var(--text-scale,1)); border:1px dashed var(--border); background:none; }
.context-note { display:block; font-size:calc(14px * var(--text-scale,1)); color:var(--muted); line-height:1.8; margin-bottom:18px; }
.detail-meta { display:flex; justify-content:space-between; color:var(--muted); font-size:calc(13px * var(--text-scale,1)); margin-bottom:20px; }
.detail-text { display:block; white-space:pre-wrap; line-height:1.9; font-size:calc(18px * var(--text-scale,1)); overflow-wrap:break-word; margin-bottom:22px; }
.detail-weight { display:block; font-size:calc(36px * var(--text-scale,1)); margin-bottom:16px; }
.detail-media { margin-bottom:14px; border-radius:12px; overflow:hidden; background:var(--soft); }
