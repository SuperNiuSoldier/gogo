.detail-media video { width:100%; height:220px; }
.detail-actions { display:flex; align-items:center; justify-content:space-between; }
.storage-number { font-size:calc(40px * var(--text-scale,1)); display:block; margin-bottom:22px; }
.storage-number text { font-size:calc(18px * var(--text-scale,1)); }
.privacy-backdrop { position:absolute; inset:0; z-index:20; background:var(--scrim); display:flex; align-items:center; justify-content:center; padding:24px; }
.privacy-card { background:var(--paper); border-radius:24px; padding:24px; width:100%; }
.privacy-card .sheet-title { display:block; margin-bottom:18px; }
@keyframes sheet-enter { from { transform:translateY(24px); opacity:0; } to { transform:translateY(0); opacity:1; } }
.reduce-motion .sheet { animation:none; }
.reduce-motion .album-slide { transition:none; filter:none; transform:none; }
@media (prefers-reduced-motion:reduce) { .sheet { animation:none; } .album-slide { transition:none; filter:none; transform:none; } }
@media (max-width:350px) { .pet-bar { padding-left:12px; padding-right:10px; } .heading { padding-left:18px; padding-right:14px; } .album-slide { padding-left:12px; padding-right:12px; }
.app .paper-card { padding:14px; } .calendar { padding:0 6px; } .month-label { font-size:calc(15px * var(--text-scale,1)); } .quick-grid { gap:10px 6px; } .sheet-body { padding-left:18px; padding-right:18px; } .sheet-title { font-size:calc(19px * var(--text-scale,1)); } }
@media (max-height:600px) { .album-swiper { min-height:180px; } .card-meta { margin-bottom:8px; } .card-text { -webkit-line-clamp:2; margin-top:10px; } .card-bottom { margin-top:8px; }
.app .calendar-expand { min-height:44px; }
.app .day { height:44px; } }

.field-label-row { display:flex; align-items:center; justify-content:space-between; min-height:36px; color:var(--muted); margin-bottom:8px; }
.large-text .date-fields { flex-direction:column; gap:0; }
.large-text .calendar-heading { flex-wrap:wrap; }

/* Rouqiu is a character skin, independent from brightness and the selected pet. */
.skin-rouqiu { --bg:#f6f1e7; --paper:#fffcf5; --soft:#e6ebdf; --ink:#344439; --muted:#5e6d61; --accent:#4e6a58; --line:#d9dece; --border:#7c887a; }
.skin-rouqiu.theme-dark { --bg:#202821; --paper:#2c372f; --soft:#3a493d; --ink:#fbf4e7; --muted:#c4cebd; --accent:#c4d4b6; --on-accent:#243528; --line:#52644f; --border:#7f9579; }
.memory-backdrop { position:absolute; top:112px; bottom:84px; left:0; right:0; pointer-events:none; overflow:hidden; }
.memory-backdrop > image { width:100%; height:100%; opacity:.19; }
.memory-wash { position:absolute; inset:0; background:linear-gradient(180deg,var(--bg),transparent 38%,var(--bg)); }
.app > .pet-bar,.app > .heading,.app > .content,.app > .bottom-nav,.app > .empty,.app > .draft-banner,.app > .history-return { position:relative; }
.skin-rouqiu .theme-toggle-mark { width:44px; height:44px; }
.skin-rouqiu .pet-chip.selected { background:var(--paper); }
.skin-rouqiu .page-title { color:var(--accent); }
.skin-rouqiu .paper-card { border-radius:16px 20px 18px 22px; box-shadow:0 5px 20px #3444390d; }
.skin-rouqiu .card-no-photo .record-mark { width:96px; height:96px; }
.skin-rouqiu .moment-icon { width:68px; height:68px; margin:4px 0; }
.skin-rouqiu .empty-mark { width:84px; height:84px; opacity:1; }
.skin-rouqiu .welcome-mark { width:156px; height:156px; padding:0; background:none; }
.skin-rouqiu .nav-mark { width:60px; height:43px; }
.skin-rouqiu .nav-mark .icon { width:48px; height:48px; }
.skin-rouqiu .bottom-nav { border-radius:28px 25px 29px 25px; }
.skin-rouqiu .quick-grid { gap:10px 8px; }
.skin-rouqiu .quick-item { min-height:112px; gap:4px; border:0; background:transparent; border-radius:18px; padding:3px 0 8px; }
.skin-rouqiu .quick-icon { width:74px; height:74px; max-width:100%; object-fit:contain; filter:drop-shadow(0 1px 2px #263c2526); }
.skin-rouqiu .reminder-open > .icon { width:38px; height:38px; }
.keepsake { flex:1; min-height:170px; position:relative; margin:8px 20px 4px; overflow:hidden; border-radius:24px 25px 23px 26px; background:var(--soft); }
.keepsake.has-photo { border:5px solid var(--paper); box-shadow:0 4px 18px #34443913; }
.keepsake-photo { width:100%; height:100%; position:absolute; inset:0; object-fit:cover; }
